rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc webhooks khi đã đăng nhập
    match /webhooks/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Cho phép đọc và ghi logs khi đã đăng nhập
    match /logs/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Nguồn phim: đọc công khai, ghi cần đăng nhập
    match /sources/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Timeframe mở cấp (JXM): đọc công khai, ghi cần đăng nhập
    match /jxmTimeframes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Link phim cố định: đọc công khai, ghi cần đăng nhập
    match /curatedLinks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}